# Embedder: "mock" (default, zero external deps) or "ollama"
EMBEDDER=mock
# Ollama host, used only when EMBEDDER=ollama
OLLAMA_HOST=http://localhost:11434
# Retrieval depth (top-k chunks)
TOP_K=5

# Text-to-speech for the answer card's Listen button. Server-side only — the key is
# never sent to the browser. Without it the button returns a "not configured" message.
ELEVENLABS_API_KEY=
# Optional overrides — defaults are the "George" public voice + eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
